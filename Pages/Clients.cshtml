@page
@model LogisticsWeb.Pages.ClientsModel
@{
    ViewData["Title"] = "База клиентов";
}

<h2 class="mb-3">База клиентов</h2>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white fw-bold">Добавить клиента</div>
            <div class="card-body">
                <form method="post" asp-page-handler="Add">
                    <div class="mb-2">
                        <label class="form-label">ФИО клиента</label>
                        <input asp-for="InputClient.FullName" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Адрес</label>
                        <input asp-for="InputClient.Address" id="addressInput" class="form-control" autocomplete="off" required />
                        <div id="addressSuggestions" class="dropdown-menu show" style="display:none; max-height:220px; overflow-y:auto;"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Сумма заказа, ₽</label>
                        <input asp-for="InputClient.OrderAmount" class="form-control" type="number" step="0.01" min="0" required />
                    </div>
                    <input type="hidden" asp-for="InputClient.Coordinates" id="coordinates" />
                    <button type="submit" class="btn btn-success">Добавить</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white fw-bold">Импорт на карту</div>
            <div class="card-body">
                <p class="mb-2 text-muted">Точки на карте будут установлены строго по адресам из базы данных.</p>
                <form method="post" asp-page="/Index" asp-page-handler="ImportClients">
                    <button type="submit" class="btn btn-primary">Импортировать клиентов на карту</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-secondary text-white fw-bold">Список клиентов (@Model.Clients.Count)</div>
    <div class="card-body p-0">
    @if (Model.Clients.Count == 0)
    {
        <div class="p-3 text-muted">База пуста. Добавьте первого клиента.</div>
    }
    else
    {
        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>ФИО</th>
                    <th>Адрес</th>
                    <th class="text-end">Сумма</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var c in Model.Clients)
            {
                <tr id="row-@c.Id">
                    <form method="post" asp-page-handler="Update" asp-route-id="@c.Id">
                        <td>@c.Id</td>
                        <td><input name="FullName" class="form-control form-control-sm" value="@c.FullName" /></td>
                        <td><input name="Address" class="form-control form-control-sm" value="@c.Address" /></td>
                        <td><input name="OrderAmount" class="form-control form-control-sm text-end" value="@c.OrderAmount" /></td>
                        <td>
                            <button type="submit" class="btn btn-sm btn-outline-primary">Сохранить</button>
                            <button type="submit" formaction="/Clients" formmethod="post" name="handler" value="Delete" class="btn btn-sm btn-outline-danger">Удалить</button>
                        </td>
                    </form>
                </tr>
            }
            </tbody>
        </table>
    }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var input = document.getElementById("addressInput");
            var box = document.getElementById("addressSuggestions");
            var coordField = document.getElementById("coordinates");
            var selectedAddress = "";
            var debounceTimer = null;

            input.addEventListener("input", function () {
                var term = input.value.trim();
                if (term.length < 3) {
                    box.style.display = "none";
                    return;
                }

                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(function () {
                    fetch("/Clients?handler=Suggest&term=" + encodeURIComponent(term))
                        .then(function (r) { return r.json(); })
                        .then(function (data) {
                            box.innerHTML = "";
                            if (!data || data.length === 0) {
                                box.style.display = "none";
                                return;
                            }

                            data.forEach(function (item) {
                                var el = document.createElement("a");
                                el.className = "dropdown-item";
                                el.href = "#";
                                el.textContent = item.address;
                                el.addEventListener("click", function (e) {
                                    e.preventDefault();
                                    input.value = item.address;
                                    coordField.value = item.latitude + ";" + item.longitude;
                                    selectedAddress = item.address;
                                    box.style.display = "none";
                                });
                                box.appendChild(el);
                            });
                            box.style.display = "block";
                        });
                }, 250);
            });

            document.addEventListener("click", function (e) {
                if (!box.contains(e.target) && e.target !== input) {
                    box.style.display = "none";
                }
            });
        });
    </script>
}