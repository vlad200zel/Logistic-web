@page
@using System.Text.Json
@model LogisticsWeb.Pages.IndexModel
@{
    ViewData["Title"] = "Расчет выгоды маршрута";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet-polylinedecorator@1.6.0/dist/leaflet.polylineDecorator.css" />

<div class="container-fluid mt-3">
    <h2 class="mb-3">Оптимизация доставки с учётом прибыльности</h2>

    <div class="row mb-3">
        <div class="col-md-12 d-flex gap-2">
            <form method="post" asp-page-handler="GeneratePoints">
                <button type="submit" class="btn btn-secondary btn-lg">
                    1. Сгенерировать случайные точки
                </button>
            </form>

            <form method="post" asp-page-handler="CalculateRoute">
                <button type="submit" class="btn btn-primary btn-lg" @(Model.MapPoints.Count == 0 ? "disabled" : "")>
                    2. Рассчитать оптимальный маршрут
                </button>
            </form>

            <form method="post" asp-page-handler="ImportClients">
                <button type="submit" class="btn btn-info btn-lg">
                    3. Импорт клиентов из базы
                </button>
            </form>
        </div>
    </div>

    <div class="row">
        <!-- Карта -->
        <div class="col-md-8">
            <div id="map" style="height: 600px; border-radius: 8px;" class="shadow-sm border"></div>
        </div>

        <!-- Информация и лог -->
        <div class="col-md-4">
            @if (Model.IsCalculated)
            {
                <div class="card mb-3 shadow-sm">
                    <div class="card-header bg-dark text-white fw-bold">Финансовые показатели</div>
                    <div class="card-body">
                        <p class="mb-1"><strong>Общий доход:</strong> @Model.TotalRevenue.ToString("N0") ₽</p>
                        <p class="mb-1"><strong>Пробег:</strong> @Model.TotalDistance.ToString("F1") км</p>
                        <p class="mb-1"><strong>Расходы (900 ₽/км):</strong> @Model.TravelCost.ToString("N0") ₽</p>
                        <hr />
                        <h5 class="card-title text-success">
                            <strong>Чистая прибыль:</strong> @Model.NetProfit.ToString("N0") ₽
                        </h5>
                    </div>
                </div>
            }

            </div>
    </div>

    @if (Model.IsCalculated && Model.RouteSteps.Any())
    {
        <div class="row mt-4">
            <div class="col-md-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white fw-bold">Детализация затрат по этапам</div>
                    <div class="card-body p-0">
                        <table class="table table-striped table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Этап</th>
                                    <th>Точка</th>
                                    <th>Расстояние</th>
                                    <th>Доход за заказ</th>
                                    <th>Затраты на дорогу (900 ₽/км)</th>
                                    <th>Прибыль участка</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var step in Model.RouteSteps)
                                {
                                    <tr>
                                        <td><span class="badge bg-info text-dark">@step.Status</span></td>
                                        <td>@step.Name</td>
                                        <td>@step.LegDistanceKm.ToString("F1") км</td>
                                        <td class="text-success fw-bold">@(step.Revenue > 0 ? $"{step.Revenue:N0} ₽" : "—")</td>
                                        <td class="text-danger">@(step.LegCost > 0 ? $"{step.LegCost:N0} ₽" : "—")</td>
                                        <td class="@(step.LegProfit >= 0 ? "text-success" : "text-danger") fw-bold">
                                            @(step.LegProfit != 0 ? $"{step.LegProfit:N0} ₽" : "—")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-dark fw-bold">
                                    <td colspan="2">ИТОГО по маршруту</td>
                                    <td>@Model.TotalDistance.ToString("F1") км</td>
                                    <td class="text-success">@Model.TotalRevenue.ToString("N0") ₽</td>
                                    <td class="text-danger">@Model.TravelCost.ToString("N0") ₽</td>
                                    <td class="@(Model.NetProfit >= 0 ? "text-success" : "text-danger")">
                                        @Model.NetProfit.ToString("N0") ₽
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet-polylinedecorator@1.6.0/dist/leaflet.polylineDecorator.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        var map = L.map('map', { attributionControl: false }).setView([55.751244, 37.618423], 10);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap'
        }).addTo(map);

        var points = @Html.Raw(JsonSerializer.Serialize(Model.MapPoints));
        var isCalculated = @Model.IsCalculated.ToString().ToLower();

        if (points.length === 0) return;

        points.forEach(function(pt) {
            var color = 'gray';
            var popupContent = `<b>${pt.Name}</b><br/>Доход: ${pt.Revenue} ₽`;

            if (pt.IsBase) {
                color = 'blue';
                popupContent = `<b>${pt.Name}</b> (Старт/Финиш)`;
            } else if (isCalculated) {
                if (pt.IsVisited) {
                    color = 'green';
                    popupContent += `<br/><b style="color:green;">[ВКЛЮЧЕНА - Остановка ${pt.RouteOrder}]</b>`;
                } else {
                    color = 'red';
                    popupContent += `<br/><b style="color:red;">[ОТБРОШЕНА - Поездка не окупается]</b>`;
                }
            }

            var marker = L.circleMarker([pt.Latitude, pt.Longitude], {
                color: color,
                fillColor: color,
                fillOpacity: 0.8,
                radius: pt.IsBase ? 10 : 8
            }).addTo(map);

            marker.bindPopup(popupContent);
        });

        if (isCalculated) {
            // Собираем точки, вошедшие в итоговый маршрут
            var visitedPoints = points.filter(p => p.IsBase || p.IsVisited)
                .sort((a, b) => a.RouteOrder - b.RouteOrder);

            if (visitedPoints.length > 1) {
                // Формируем точки для запроса геометрии OSRM (в формате Долгота,Широта)
                var osrmWaypoints = visitedPoints.map(p => `${p.Longitude},${p.Latitude}`);

                // Возврат на склад
                osrmWaypoints.push(`${points[0].Longitude},${points[0].Latitude}`);

                var osrmUrl = `https://router.project-osrm.org/route/v1/driving/${osrmWaypoints.join(';')}?overview=full&geometries=geojson`;

                // Запрашиваем трек дороги с OSRM
                fetch(osrmUrl)
                    .then(response => response.json())
                    .then(data => {
                        if (data.routes && data.routes.length > 0) {
                            var routeGeoJSON = data.routes[0].geometry;

                            // Координаты приходят в формате [Долгота, Широта], Leaflet ждёт [Широта, Долгота]
                            var latLngs = routeGeoJSON.coordinates.map(function (c) {
                                return [c[1], c[0]];
                            });

                            var routeLayer = L.polyline(latLngs, {
                                color: '#28a745',
                                weight: 5,
                                opacity: 0.8
                            }).addTo(map);

                            // Стрелки направления движения вдоль линии маршрута
                            L.polylineDecorator(routeLayer, {
                                patterns: [{
                                    offset: 0,
                                    repeat: 100,
                                    symbol: L.Symbol.arrowHead({
                                        pixelSize: 10,
                                        polygon: false,
                                        pathOptions: {
                                            color: '#0b5d1e',
                                            weight: 2,
                                            opacity: 0.7
                                        }
                                    })
                                }]
                            }).addTo(map);

                            // Фокусируем карту на созданном маршруте
                            map.fitBounds(routeLayer.getBounds(), { padding: [30, 30] });
                        }
                    })
                    .catch(err => {
                        console.error('Ошибка отрисовки трека OSRM:', err);
                    });
            }
        }
    });
</script>